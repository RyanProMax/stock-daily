{
  "name": "stock-daily",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npm run build && wrangler pages dev dist",
    "check": "npm run contracts:check && tsc --noEmit",
    "build": "npm run check && vite build && vite build --mode client",
    "preview": "npm run build && wrangler pages dev dist",
    "pages:dev": "npm run preview",
    "security:check": "node scripts/check-public-repo.mjs",
    "daily:collect": "node scripts/daily-collect.mjs",
    "daily:freshness": "node scripts/daily-freshness.mjs",
    "daily:check": "node scripts/daily-workflow-check.mjs --require-complete",
    "daily:workflow": "node scripts/daily-workflow.mjs",
    "daily:workflow:acceptance": "node scripts/daily-workflow-acceptance.mjs",
    "daily:workflow:publish": "node scripts/daily-workflow-publish.mjs",
    "daily:publish": "node scripts/daily-workflow-publish.mjs",
    "daily:verify": "node scripts/daily-workflow-check.mjs --production --require-complete",
    "daily:replace": "node scripts/replace-daily-reports.mjs",
    "daily:run": "scripts/run-codex-daily.sh --force --update-kind morning --market US",
    "daily:close": "scripts/run-codex-daily.sh --force --update-kind close --market CN",
    "daily:evening": "scripts/run-codex-daily.sh --force --update-kind evening",
    "daily:shadow": "scripts/run-codex-daily.sh --force --shadow --update-kind evening",
    "weekly:collect": "node scripts/weekly-collect.mjs",
    "weekly:check": "node scripts/weekly-publish.mjs --check",
    "weekly:publish": "node scripts/weekly-publish.mjs",
    "weekly:verify": "node scripts/weekly-verify.mjs",
    "weekly:run": "scripts/run-codex-weekly.sh --force",
    "db:migrate:remote": "wrangler d1 migrations apply stock-daily-db --config wrangler.data.jsonc --remote",
    "deploy": "npm run build && wrangler pages deploy dist --project-name stock-daily --branch main --commit-dirty=true",
    "test": "npm run build && python3 -m unittest tests/test_x_intelligence.py && node --test tests/*.test.mjs",
    "contracts:generate": "node scripts/report-contract-types.mjs",
    "contracts:check": "node scripts/report-contract-types.mjs --check"
  },
  "dependencies": {
    "@cfworker/json-schema": "4.1.1",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@fontsource-variable/noto-serif-sc": "^5.3.0",
    "hono": "^4.12.32",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.26.0",
    "pdfjs-dist": "5.6.205",
    "react": "^19.2.6",
    "react-aria-components": "^1.19.0",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260723.1",
    "@hono/vite-build": "^1.11.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "typescript": "5.9.3",
    "vite": "^8.1.5",
    "wrangler": "4.114.0"
  }
}
