{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stock Daily Independent Recap Review V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "verdict",
    "summary",
    "reviewAudit",
    "claimReviews",
    "qualityChecks",
    "marketReviews"
  ],
  "properties": {
    "contractVersion": {
      "type": "string",
      "const": "stock-daily-recap-review-v1"
    },
    "verdict": { "type": "string", "enum": ["pass", "revise"] },
    "summary": { "type": "string", "minLength": 20, "maxLength": 600 },
    "reviewAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["CN", "US"],
      "properties": {
        "CN": { "$ref": "#/$defs/reviewSearches" },
        "US": { "$ref": "#/$defs/reviewSearches" }
      }
    },
    "claimReviews": {
      "type": "array",
      "maxItems": 12,
      "items": { "$ref": "#/$defs/claimReview" }
    },
    "qualityChecks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "noUnsupportedClaims",
        "explainsRatherThanRestates",
        "allSourcesTraceable",
        "alternativesTested",
        "emptyAttributionHonest"
      ],
      "properties": {
        "noUnsupportedClaims": { "type": "boolean" },
        "explainsRatherThanRestates": { "type": "boolean" },
        "allSourcesTraceable": { "type": "boolean" },
        "alternativesTested": { "type": "boolean" },
        "emptyAttributionHonest": { "type": "boolean" }
      }
    },
    "marketReviews": {
      "type": "object",
      "additionalProperties": false,
      "required": ["CN", "US"],
      "properties": {
        "CN": { "$ref": "#/$defs/marketReview" },
        "US": { "$ref": "#/$defs/marketReview" }
      }
    }
  },
  "$defs": {
    "claimReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "market",
        "publishedAs",
        "publishedTitle",
        "publishedClaim",
        "source",
        "supportedScope",
        "verdict",
        "summary"
      ],
      "properties": {
        "market": { "type": "string", "enum": ["CN", "US"] },
        "publishedAs": { "type": "string", "enum": ["market_driver", "ai_update"] },
        "publishedTitle": { "type": "string", "minLength": 5, "maxLength": 90 },
        "publishedClaim": { "type": "string", "minLength": 100, "maxLength": 460 },
        "source": { "type": "string", "minLength": 12, "maxLength": 1200, "pattern": "^https://" },
        "supportedScope": { "type": "string", "enum": ["market", "sector", "subsector", "ai_layer", "company", "none"] },
        "verdict": { "type": "string", "enum": ["pass", "revise"] },
        "summary": { "type": "string", "minLength": 20, "maxLength": 500 }
      }
    },
    "reviewSearches": {
      "type": "object",
      "additionalProperties": false,
      "required": ["queries"],
      "properties": {
        "queries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": { "type": "string", "minLength": 1, "maxLength": 220 }
        }
      }
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "factualAccuracy",
        "causalLogic",
        "evidenceDirectness",
        "alternativeTesting",
        "readerUtility"
      ],
      "properties": {
        "factualAccuracy": { "type": "integer", "minimum": 1, "maximum": 5 },
        "causalLogic": { "type": "integer", "minimum": 1, "maximum": 5 },
        "evidenceDirectness": { "type": "integer", "minimum": 1, "maximum": 5 },
        "alternativeTesting": { "type": "integer", "minimum": 1, "maximum": 5 },
        "readerUtility": { "type": "integer", "minimum": 1, "maximum": 5 }
      }
    },
    "marketReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "scores", "summary", "issues", "revisionActions"],
      "properties": {
        "verdict": { "type": "string", "enum": ["pass", "revise"] },
        "scores": { "$ref": "#/$defs/scores" },
        "summary": { "type": "string", "minLength": 20, "maxLength": 600 },
        "issues": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "minLength": 8, "maxLength": 400 }
        },
        "revisionActions": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "minLength": 8, "maxLength": 400 }
        }
      }
    }
  }
}
