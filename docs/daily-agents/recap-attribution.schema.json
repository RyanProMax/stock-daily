{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["contractVersion", "market", "marketAsOf", "entries"],
  "properties": {
    "contractVersion": {"const": "verified-recap-attribution-v1", "type": "string"},
    "market": {"type": "string", "enum": ["CN", "US"]},
    "marketAsOf": {"type": "string", "minLength": 10, "maxLength": 10},
    "entries": {
      "type": "array", "minItems": 20, "maxItems": 20,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["target", "basis", "observedReturn", "chains", "counterEvidenceIds", "counterAssessment"],
        "properties": {
          "target": {"type": "string", "minLength": 1, "maxLength": 80},
          "basis": {"type": "string", "enum": ["reported", "inferred", "unresolved"]},
          "observedReturn": {"type": "string", "minLength": 2, "maxLength": 20},
          "counterAssessment": {"type": "string", "minLength": 40, "maxLength": 1200},
          "counterEvidenceIds": {"type": "array", "maxItems": 6, "items": {"type": "string", "minLength": 1, "maxLength": 80}},
          "chains": {
            "type": "array", "maxItems": 3,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["rootEvidenceId", "reactionEvidenceId", "timingEvidenceId", "mechanismEvidenceIds", "eventAnchors", "expectedDirection", "transmission", "limitations"],
              "properties": {
                "rootEvidenceId": {"type": "string", "minLength": 1, "maxLength": 80},
                "reactionEvidenceId": {"type": "string", "minLength": 1, "maxLength": 80},
                "timingEvidenceId": {"type": ["string", "null"], "minLength": 1, "maxLength": 80},
                "mechanismEvidenceIds": {"type": "array", "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 80}},
                "eventAnchors": {"type": "array", "minItems": 2, "maxItems": 5, "items": {"type": "string", "minLength": 2, "maxLength": 100}},
                "expectedDirection": {"type": "string", "enum": ["positive", "negative", "flat"]},
                "transmission": {"type": "string", "minLength": 50, "maxLength": 1200},
                "limitations": {"type": "string", "minLength": 30, "maxLength": 900}
              }
            }
          }
        }
      }
    }
  }
}
