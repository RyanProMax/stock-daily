{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stock Daily Market Plan V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "market", "marketAsOf", "anomalies"],
  "properties": {
    "contractVersion": { "type": "string", "const": "stock-daily-market-plan-v1" },
    "market": { "type": "string", "enum": ["CN", "US"] },
    "marketAsOf": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "anomalies": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/anomaly" }
    }
  },
  "$defs": {
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "claim", "category"],
      "properties": {
        "id": { "type": "string", "minLength": 3, "maxLength": 50 },
        "claim": { "type": "string", "minLength": 8, "maxLength": 260 },
        "category": {
          "type": "string",
          "enum": ["company_event", "macro_policy", "industry_supply_demand", "positioning", "alternative"]
        }
      }
    },
    "anomaly": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "target", "title", "direction", "observedMove", "researchQuestion", "hypotheses", "factQueries", "causalQueries"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{2,39}$" },
        "kind": { "type": "string", "enum": ["market", "sector", "ai_layer", "company"] },
        "target": { "type": "string", "minLength": 1, "maxLength": 80 },
        "title": { "type": "string", "minLength": 5, "maxLength": 120 },
        "direction": { "type": "string", "enum": ["positive", "negative", "mixed"] },
        "observedMove": { "type": "string", "minLength": 2, "maxLength": 160 },
        "researchQuestion": { "type": "string", "minLength": 10, "maxLength": 300 },
        "hypotheses": { "type": "array", "minItems": 3, "maxItems": 4, "items": { "$ref": "#/$defs/hypothesis" } },
        "factQueries": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "type": "string", "minLength": 3, "maxLength": 220 } },
        "causalQueries": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "type": "string", "minLength": 3, "maxLength": 220 } }
      }
    }
  }
}
