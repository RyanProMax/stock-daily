{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["contractVersion", "market", "marketAsOf", "queries", "sourceUrls"],
  "properties": {
    "contractVersion": {"type": "string", "const": "stock-daily-recap-discovery-v1"},
    "market": {"type": "string", "const": "US"},
    "marketAsOf": {"type": "string", "minLength": 10, "maxLength": 10},
    "queries": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string", "minLength": 10, "maxLength": 500}},
    "sourceUrls": {"type": "array", "maxItems": 8, "items": {"type": "string", "minLength": 8, "maxLength": 2048}}
  }
}
