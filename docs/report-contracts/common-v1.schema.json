        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "pattern": "\\S"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "pattern": "\\S"
        },
        "evidence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "pattern": "\\S"
        },
        "source": {
          "$ref": "#/$defs/url"
        },
        "sourceLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
