# Optional when Wrangler cannot infer the intended Cloudflare account.
CLOUDFLARE_ACCOUNT_ID=

# Optional launchd overrides when Node.js or Codex is not on a standard path.
STOCK_DAILY_NODE_BIN_DIR=
STOCK_DAILY_CODEX_BIN=

# Optional overrides for the one-shot stock-analysis-api Skill CLI.
# By default Stock Daily uses the sibling ../stock-analysis-api repository and
# resolves uv from common absolute install paths.
STOCK_ANALYSIS_API_ROOT=
STOCK_ANALYSIS_UV=
